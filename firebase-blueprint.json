{
  "entities": {
    "Product": {
      "title": "Fashion Product",
      "description": "A clothing, footwear, or accessory item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number", "description": "Base price in INR" },
        "category": { "type": "string", "enum": ["Men", "Women", "Kids", "Footwear", "Accessories"] },
        "subCategory": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isFeatured": { "type": "boolean" },
        "discount": { "type": "number", "description": "Percentage discount" }
      },
      "required": ["name", "price", "category", "images"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "A completed purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processed", "shipped", "delivered", "cancelled"] },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    },
    "User": {
      "title": "User Profile",
      "description": "Customer or Admin profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "preferredCurrency": { "type": "string" },
        "preferredCountry": { "type": "string" },
        "wishlist": { "type": "array", "items": { "type": "string" } },
        "addresses": { "type": "array" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Fashion products available in the store"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer order records"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and preferences"
    }
  }
}
